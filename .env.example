# Local mode is opt-in and must never be enabled in production.
NODE_ENV=development
WORKEVA_LOCAL_MODE=true
WORKEVA_STATE_FILE=.data/state.json
WORKEVA_FILE_DIR=.data/files
WORKEVA_MAX_FILE_BYTES=52428800
WORKEVA_MAX_PAGES=200
# Local browser persona must match a provisioned seed user (avery, jordan, publisher, admin).
# x-workeva-user or workeva-user cookie is accepted only in local mode.

# Production identity (required outside local mode)
ENTRA_TENANT_ID=
ENTRA_AUDIENCE=
ENTRA_ISSUER=
ENTRA_JWKS_URL=
# EasyAuth is ignored unless both flags are explicitly enabled behind a trusted App Service boundary.
WORKEVA_TRUST_EASYAUTH=false
WEBSITE_AUTH_ENABLED=false

# Canonical origin used in notification deep links (HTTPS in production).
WORKEVA_BASE_URL=http://localhost:3000

# Azure SQL production aggregate store
AZURE_SQL_SERVER=
AZURE_SQL_DATABASE=
# Prefer managed identity. Set these only for a separately approved SQL credential path.
AZURE_SQL_USER=
AZURE_SQL_PASSWORD=

# Azure Blob production evidence store (private container, Defender scan integration required)
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=evidence
WORKEVA_SCAN_TAG=Malware Scanning scan result

# Optional post-MVP Databricks reference lookup
DATABRICKS_HOST=
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_REFERENCE_TABLE=main.workeva.reporting_entities
DATABRICKS_TOKEN=
DATABRICKS_TIMEOUT_MS=15000
DATABRICKS_MAX_POLLS=30

# Outbox worker defaults to a recorded dry run. Sending requires both explicit flags and Graph identity.
WORKEVA_NOTIFICATION_PROVIDER=dry-run
WORKEVA_NOTIFICATION_SEND=false
WORKEVA_NOTIFICATION_SENDER=
WORKEVA_WORKER_ONCE=false
WORKEVA_WORKER_INTERVAL_MS=5000
